# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local development (docker compose up):
DATABASE_URL=postgresql://inspector:inspector@localhost:5433/inspector
#
# Production (Neon). Use the POOLED connection string — the one with "-pooler"
# in the hostname. Neon scales compute to zero after ~5 min idle, and a hot
# connection pool against a direct (unpooled) endpoint is the classic
# serverless-Postgres footgun.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Redis (live view pub/sub only — never durable storage) ------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (payloads) ----------------------------------------------
# Local: MinIO via docker compose. Production: Cloudflare R2 (S3-compatible,
# so the same client code works against both).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=inspector-payloads
S3_ACCESS_KEY_ID=inspector
S3_SECRET_ACCESS_KEY=inspector123
S3_REGION=auto

# --- Server -----------------------------------------------------------------
PORT=4000
LOG_LEVEL=info
