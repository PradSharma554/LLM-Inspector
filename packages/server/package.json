{
  "name": "@llm-inspector/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps --env-file=../../.env dist/main.js",
    "start": "node --enable-source-maps --env-file=../../.env dist/main.js",
    "start:bare": "node --enable-source-maps dist/main.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/db/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@llm-inspector/protocol": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
