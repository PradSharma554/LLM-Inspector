{
  "name": "@llm-inspector/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "test": "tsc -p tsconfig.json && node --test dist/**/*.test.js",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/db/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@fastify/cors": "^11.3.0",
    "@llm-inspector/protocol": "workspace:*",
    "fastify": "^5.11.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
